<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    tools:context=".ui.transaction.TransactionActivity">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIconTint="?attr/colorTextDetailTransaction"
            app:title="@string/title_transaction_history"
            app:titleTextAppearance="@style/ToolbarTitleDetailTransaction"
            app:titleTextColor="?attr/colorTextDetailTransaction" />
    </com.google.android.material.appbar.AppBarLayout>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="24dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="?attr/backgroundColorCardTransaction"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="12dp"
            android:layout_marginVertical="16dp"
            >

            <FrameLayout
                android:id="@+id/layout_dropdown_type_transaction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_spinner_type_transaction"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/layout_dropdown_filter_range_transaction"
                >

                <Spinner
                    android:id="@+id/dropdown_type_transaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownWidth="wrap_content"
                    android:overlapAnchor="false"
                    android:backgroundTint="?attr/colorForegroundSpinnerTypeTransaction"
                    android:popupBackground="@drawable/bg_spinner_type_transaction"
                    android:spinnerMode="dropdown" />
            </FrameLayout>



            <FrameLayout
                android:id="@+id/layout_dropdown_filter_range_transaction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_spinner_filter_range_transaction"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/layout_dropdown_type_transaction"
                app:layout_constraintEnd_toEndOf="parent"
                >

                <Spinner
                    android:id="@+id/dropdown_filter_range_transaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownWidth="wrap_content"
                    android:overlapAnchor="false"
                    android:backgroundTint="?attr/colorForegroundSpinnerFilterRangeTransaction"
                    android:popupBackground="@drawable/bg_spinner_filter_range_transaction"
                    android:spinnerMode="dropdown" />
            </FrameLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="?attr/backgroundColorCardTransaction"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/card_spinner"
        app:strokeWidth="0dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_card_summary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="14dp"
            android:visibility="invisible"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_vertical_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.63" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_horizontal_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.78" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_medium"
                android:letterSpacing="0.01"
                android:text="@string/title_summary"
                android:textColor="?attr/colorTitleCardSummary"
                android:textSize="14sp"
                app:layout_constraintEnd_toStartOf="@id/guideline_vertical_summary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"

                />

            <LinearLayout
                android:id="@+id/layout_value_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintBottom_toTopOf="@id/guideline_horizontal_summary"
                app:layout_constraintEnd_toStartOf="@id/guideline_vertical_summary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title_summary">

                <LinearLayout
                    android:id="@+id/layout_summary_income"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_title_summary_income"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.01"
                        android:text="@string/title_summary_income"
                        android:textColor="?attr/colorTitleCardSummary"
                        android:textSize="12sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_value_summary_income"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/example_value_income"
                        android:textColor="?attr/colorValueIncomeCardSummary"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_summary_expense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_title_summary_expense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.01"
                        android:text="@string/title_summary_expense"
                        android:textColor="?attr/colorTitleCardSummary"
                        android:textSize="12sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_value_summary_expense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/example_value_expense"
                        android:textColor="?attr/colorValueExpenseCardSummary"
                        android:textSize="12sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_summary_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_title_summary_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:letterSpacing="0.01"
                        android:text="@string/title_summary_total"
                        android:textColor="?attr/colorTitleCardSummary"
                        android:textSize="12sp" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_value_summary_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/inter_medium"
                        android:text="@string/example_value_income"
                        android:textColor="?attr/colorValueTotalCardSummary"
                        android:textSize="12sp" />

                </LinearLayout>


            </LinearLayout>

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pie_chart_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_centerInParent="true"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@id/guideline_horizontal_summary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/guideline_vertical_summary"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layout_label_pie_income"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical|start"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/pie_chart_summary"
                app:layout_constraintStart_toStartOf="@id/pie_chart_summary"
                app:layout_constraintTop_toBottomOf="@id/guideline_horizontal_summary"
                app:layout_constraintVertical_chainStyle="packed">


                <View
                    android:id="@+id/rectangle_label_pie_chart_income"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="?attr/colorIncomePieChart" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_label_pie_chart_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/label_pie_chart_income"
                    android:textColor="?attr/colorTitleCardSummary"
                    android:textSize="9sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layout_label_pie_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical|start"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/layout_label_pie_income"
                app:layout_constraintTop_toBottomOf="@id/layout_label_pie_income">

                <View
                    android:id="@+id/rectangle_label_pie_chart_expense"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:background="?attr/colorExpensePieChart" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_label_pie_chart_expense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/label_pie_chart_expense"
                    android:textColor="?attr/colorTitleCardSummary"
                    android:textSize="9sp"
                    tools:ignore="SmallSp" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/loading_indicator_card_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:indicatorSize="30dp"
            android:indeterminate="true"
            android:layout_gravity="center"
            app:indicatorColor="?attr/colorValueTotalCardSummary"
            android:visibility="invisible"
            tools:visibility="visible"
            />

    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_transaction_history"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="24dp"
        android:layout_marginTop="12dp"
        tools:listitem="@layout/item_transaction_history"
        app:layout_constraintTop_toBottomOf="@id/card_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_empty_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/poppins_medium"
        android:letterSpacing="0.01"
        android:text="@string/empty_transaction"
        android:textColor="?attr/colorTitleTransactionHistoryDashboard"
        android:textSize="12sp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/card_summary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />


    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_indicator_transaction_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:indicatorSize="30dp"
        android:indeterminate="true"
        android:layout_marginTop="48dp"
        android:layout_gravity="center"
        app:indicatorColor="?attr/colorTitleCardSummary"
        android:visibility="invisible"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/card_summary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />


</androidx.constraintlayout.widget.ConstraintLayout>